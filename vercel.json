{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/health.js": { "maxDuration": 30, "includeFiles": "api/bin/**" },
    "api/info.js": { "maxDuration": 60, "includeFiles": "api/bin/**" },
    "api/dl.js": { "maxDuration": 300, "includeFiles": "api/bin/**" }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
